@implements IDisposable
@inject RunManager RunManager
@inject DistributedRunManager DistributedRuns

@if (_rows.Count == 0)
{
    <div class="empty">
        <p>No runs yet. Press <strong>Run</strong> on a saved test and its live results show up here.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-hover">
            <thead>
                <tr>
                    <th scope="col">Test</th>
                    <th scope="col" class="hide-sm">Started</th>
                    <th scope="col">State</th>
                    <th scope="col" class="num hide-sm">Requests</th>
                    <th scope="col" class="num">Req/s</th>
                    <th scope="col" class="num">p95</th>
                    <th scope="col" class="num">Errors</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows.Take(Limit))
                {
                    var s = row.Results;
                    <tr>
                        <td>
                            <a class="row-title" href="@row.Href">@row.Name</a>
                            <RunTags Tags="row.Tags" />
                            @if (row.Agents is { } agents)
                            {
                                <span class="badge badge-agents" title="@string.Join(", ", agents)"><Icon Name="agents" />@agents.Count @(agents.Count == 1 ? "agent" : "agents")</span>
                            }
                            else if (row.Controller is { } controller)
                            {
                                <span class="badge badge-agents" title="A share of a distributed test started by @controller"><Icon Name="agents" />from @controller</span>
                            }
                        </td>
                        <td class="muted nowrap hide-sm">@Format.When(row.StartedAt)</td>
                        <td><span class="badges"><RunStateBadge State="row.State" /><VerdictBadge Snapshot="s" /></span></td>
                        <td class="num hide-sm">@s.TotalRequests.ToString("#,0")</td>
                        <td class="num">@Format.Rate(s.RequestsPerSecond)</td>
                        <td class="num">@Format.Ms(s.Latency.P95Ms)</td>
                        <td class="num @(s.FailedRequests > 0 ? "status-err" : "")">@Format.Percent(s.ErrorRate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Row> _rows = [];
    private Timer? _timer;

    [Parameter] public int Limit { get; set; } = int.MaxValue;

    protected override void OnInitialized()
    {
        Reload();
        RunManager.RunsChanged += OnRunsChanged;
        DistributedRuns.RunsChanged += OnRunsChanged;

        // Refresh live numbers of running tests once a second.
        _timer = new Timer(_ =>
        {
            if (_rows.Any(r => !r.IsFinished))
            {
                _ = InvokeAsync(() =>
                {
                    Reload();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Local runs and distributed ones are listed together, newest first, so a test is found where it was started.
    private void Reload() => _rows = RunManager.GetAll()
        .Select(r => new Row(r.Plan.Name, $"runs/{r.Id}", r.StartedAt, r.Snapshot.State, r.Snapshot, null, r.Controller, r.Tags))
        .Concat(DistributedRuns.GetAll().Select(r => new Row(r.Plan.Name, $"distributed/{r.Id}", r.StartedAt, r.Snapshot.State, r.Snapshot.Results, r.AgentNames, null, [])))
        .OrderByDescending(r => r.StartedAt)
        .ToList();

    private void OnRunsChanged() => _ = InvokeAsync(() =>
    {
        Reload();
        StateHasChanged();
    });

    public void Dispose()
    {
        RunManager.RunsChanged -= OnRunsChanged;
        DistributedRuns.RunsChanged -= OnRunsChanged;
        _timer?.Dispose();
    }

    /// <param name="Agents">The agents of a distributed run, or null for a run on this machine.</param>
    /// <param name="Controller">The controller a share of a distributed test came from, or null.</param>
    private sealed record Row(string Name, string Href, DateTimeOffset StartedAt, RunState State, LoadTestSnapshot Results, IReadOnlyList<string>? Agents, string? Controller, IReadOnlyList<string> Tags)
    {
        public bool IsFinished => State is RunState.Completed or RunState.Cancelled or RunState.Failed;
    }
}
