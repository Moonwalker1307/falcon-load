@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <a class="brand" href="/" aria-label="falcon-load home"><img src="falcon.svg" alt="" /><span class="brand-name">falcon<span>-load</span></span></a>
    <nav aria-label="Main">
        <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="/runs">Runs</NavLink>
        <NavLink href="/import">Import</NavLink>
        <NavLink href="/environments">Environments</NavLink>
        <NavLink href="/combine">Combine</NavLink>
        <NavLink href="/agents">Agents</NavLink>
    </nav>
    <a class="btn btn-primary btn-sm" href="/plans/new" aria-label="New test"><Icon Name="plus" /><span class="hide-sm">New test</span></a>
</header>

<main id="main" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet role="alert">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss btn-ghost btn-icon" aria-label="Dismiss">✕</button>
</div>
