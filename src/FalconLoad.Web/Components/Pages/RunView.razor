@page "/runs/{Id:guid}"
@implements IDisposable
@inject RunManager RunManager
@inject PlanStore PlanStore
@inject EnvironmentStore EnvironmentStore
@inject RunHistoryStore History
@inject RegressionThresholds Thresholds
@inject NavigationManager Nav

<PageTitle>@(_run?.Plan.Name ?? "Run") · falcon-load</PageTitle>

@if (_run is null)
{
    <div class="card empty">
        <h1 tabindex="-1">Run not available</h1>
        <p>Finished runs of saved tests are kept in the test's history. Other runs are kept only in memory and are cleared when the app restarts; export a run as JSON to keep it.</p>
        <a class="btn" href="/">Back to dashboard</a>
    </div>
    return;
}

@{
    var s = _run.Snapshot;
    var profile = _run.Plan.Profile;
    var last = s.Timeline.Count > 0 ? s.Timeline[^1] : null;
}

<div class="page-header">
    <div>
        <div class="eyebrow">Run</div>
        <div class="title-row">
            <h1 tabindex="-1">@_run.Plan.Name</h1>
            <RunStateBadge State="s.State" />
            <VerdictBadge Snapshot="s" />
            @if (_isBaseline)
            {
                <span class="badge badge-baseline">Baseline</span>
            }
        </div>
        <div class="meta">
            <span>Started @_run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            @if (!string.IsNullOrWhiteSpace(_run.EnvironmentName))
            {
                <span>Environment <strong>@_run.EnvironmentName</strong></span>
            }
            <span>@profile.Concurrency virtual @(profile.Concurrency == 1 ? "user" : "users")</span>
            <span>Stops after @Format.StopSummary(profile)</span>
            @if (profile.RampUpSeconds > 0)
            {
                <span>@Format.Seconds(profile.RampUpSeconds) ramp-up</span>
            }
            @if (profile.MaxRequestsPerSecond > 0)
            {
                <span>Capped at @profile.MaxRequestsPerSecond req/s</span>
            }
        </div>
    </div>
    <div class="actions">
        @if (_planSaved)
        {
            <a class="btn btn-ghost" href="plans/@_run.Plan.Id"><Icon Name="edit" />Edit test</a>
            <a class="btn btn-ghost" href="plans/@_run.Plan.Id/history"><Icon Name="history" />History</a>
        }
        @if (_stored && !_isBaseline)
        {
            <button @onclick="SetBaseline" title="Compare later runs of this test with this one"><Icon Name="flag" />Set as baseline</button>
        }
        @if (!s.IsFinished)
        {
            <button class="btn-danger" @onclick="() => _run.Stop()"><Icon Name="stop" />Stop</button>
        }
        else
        {
            <a class="btn" href="api/runs/@_run.Id/export" download title="Download the full results as JSON"><Icon Name="download" />Export JSON</a>
            <button class="btn-primary" @onclick="RunAgain"><Icon Name="rerun" />Run again</button>
        }
    </div>
</div>

@* Announce state changes only; the numbers change every second and would be too noisy to read out. *@
<div class="sr-only" role="status" aria-live="polite">@StateMessage(s)</div>

@if (_startError is not null)
{
    <div class="alert alert-error" role="alert"><Icon Name="alert" /><div><strong>Couldn't run it again.</strong> @_startError</div></div>
}

@if (s.FailureReason is not null)
{
    <div class="alert alert-error" role="alert"><Icon Name="alert" /><div><strong>The run failed.</strong> @s.FailureReason</div></div>
}

<div class="progress-block">
    <FlightProgress Value="Progress(s, profile)" Flying="!s.IsFinished" />
    <div class="progress-text">
        <span>@ProgressLabel(s, profile)</span>
        <span>@Format.Duration(s.Elapsed) elapsed</span>
    </div>
</div>

<ThresholdResults Snapshot="s" />
@if (_baseline is not null && !_isBaseline)
{
    var c = RunComparer.Compare(_baseline.Results, s, Thresholds);
    <section class="card baseline-strip @(c.HasRegression ? "is-regressed" : "")" aria-labelledby="vs-baseline-title">
        <div class="baseline-strip-head">
            <h2 id="vs-baseline-title"><Icon Name="flag" />Compared with the baseline</h2>
            <BaselineVerdict Comparison="c" />
            @if (!s.IsFinished)
            {
                <span class="small muted">so far</span>
            }
        </div>
        <dl class="baseline-deltas">
            @foreach (var key in new[] { "requestsPerSecond", "p95Ms", "p99Ms", "errorRate" })
            {
                var m = c.Overall.First(x => x.Key == key);
                <div>
                    <dt>@m.Label</dt>
                    <dd><DeltaBadge Change="m" /> <span class="small muted">from @Format.Value(m.Unit, m.Baseline)</span></dd>
                </div>
            }
        </dl>
        <a class="btn btn-sm" href="compare?baseline=@_baseline.RunId&run=@_run.Id"><Icon Name="compare" />Full comparison</a>
    </section>
}

<div class="stats">
    <div class="stat">
        <div class="label">Throughput</div>
        <div class="value">@Format.Rate(s.RequestsPerSecond)<span class="unit">req/s</span></div>
        <div class="sub">@(s.IsFinished ? "average over the run" : $"now {Format.Rate(last?.Requests ?? 0)} req/s")</div>
    </div>
    <div class="stat">
        <div class="label">p95 latency</div>
        <div class="value">@Format.Ms(s.Latency.P95Ms)</div>
        <div class="sub">median @Format.Ms(s.Latency.P50Ms)</div>
    </div>
    <div class="stat @(s.FailedRequests > 0 ? "bad" : s.TotalRequests > 0 ? "good" : "")">
        <div class="label">Error rate</div>
        <div class="value">@Format.Percent(s.ErrorRate)</div>
        <div class="sub">@s.FailedRequests.ToString("#,0") of @s.TotalRequests.ToString("#,0") failed</div>
    </div>
    <div class="stat">
        <div class="label">Requests</div>
        <div class="value">@Format.Number(s.TotalRequests)</div>
        <div class="sub">in @Format.Duration(s.Elapsed)</div>
    </div>
</div>

<div class="stats stats-secondary">
    <div class="stat"><div class="label">Mean</div><div class="value">@Format.Ms(s.Latency.MeanMs)</div></div>
    <div class="stat"><div class="label">p90</div><div class="value">@Format.Ms(s.Latency.P90Ms)</div></div>
    <div class="stat"><div class="label">p99</div><div class="value">@Format.Ms(s.Latency.P99Ms)</div></div>
    <div class="stat"><div class="label">Max</div><div class="value">@Format.Ms(s.Latency.MaxMs)</div></div>
    <div class="stat"><div class="label">Active users</div><div class="value">@s.ActiveVirtualUsers<span class="unit">/ @profile.Concurrency</span></div></div>
    <div class="stat"><div class="label">Received</div><div class="value">@Format.Bytes(s.BytesReceived)</div><div class="sub">sent @Format.Bytes(s.BytesSent)</div></div>
</div>

<div class="grid-2">
    <section class="card" aria-labelledby="tp-title">
        <div class="card-header"><h2 id="tp-title">Throughput</h2><span class="hint">requests per second</span></div>
        <LineChart AriaLabel="Requests per second over time" Series="ThroughputSeries(s)" />
    </section>
    <section class="card" aria-labelledby="lat-title">
        <div class="card-header"><h2 id="lat-title">Latency</h2><span class="hint">per second</span></div>
        <LineChart AriaLabel="Latency over time" FormatValue="Format.Ms" Series="LatencySeries(s)" />
    </section>
</div>

<section class="card card-flush" aria-labelledby="req-title">
    <div class="card-header"><h2 id="req-title">Requests</h2></div>
    <div class="table-wrap">
        <table class="table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Request</th>
                    <th scope="col" class="num">Count</th>
                    <th scope="col" class="num">Errors</th>
                    <th scope="col" class="num">Mean</th>
                    <th scope="col" class="num">p50</th>
                    <th scope="col" class="num">p95</th>
                    <th scope="col" class="num">p99</th>
                    <th scope="col" class="num">Max</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var step in s.Steps)
                {
                    var def = _run.Plan.Requests[step.StepIndex];
                    <tr>
                        <td><span class="step-num">@(step.StepIndex + 1)</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(def.Name))
                            {
                                <div class="row-title">@def.Name</div>
                            }
                            <div class="request-line"><span class="@Format.MethodClass(def.Method)">@def.Method</span><span class="mono muted" title="@def.Url">@def.Url</span></div>
                        </td>
                        <td class="num">@step.Requests.ToString("#,0")</td>
                        <td class="num @(step.Failures > 0 ? "status-err" : "")">@step.Failures.ToString("#,0")</td>
                        <td class="num">@Format.Ms(step.Latency.MeanMs)</td>
                        <td class="num">@Format.Ms(step.Latency.P50Ms)</td>
                        <td class="num">@Format.Ms(step.Latency.P95Ms)</td>
                        <td class="num">@Format.Ms(step.Latency.P99Ms)</td>
                        <td class="num">@Format.Ms(step.Latency.MaxMs)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<ChecksTable Snapshot="s" />

<div class="grid-2">
    <section class="card" aria-labelledby="codes-title">
        <h2 id="codes-title">Status codes</h2>
        @if (s.StatusCodes.Count == 0)
        {
            <div class="muted">No responses yet.</div>
        }
        else
        {
            <table>
                <tbody>
                    @foreach (var (statusCode, count) in s.StatusCodes)
                    {
                        var share = (double)count / Math.Max(1, s.TotalRequests);
                        var cls = Format.StatusClass(statusCode);
                        <tr>
                            <td class="mono @cls">@statusCode</td>
                            <td class="num">@count.ToString("#,0")</td>
                            <td>
                                <div class="share">
                                    <div class="share-bar @(cls is "status-2xx" or "status-3xx" ? "" : "bad")"><div style="width:@Css(share)%"></div></div>
                                    <span class="pct">@Format.Percent(share)</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
    <section class="card" aria-labelledby="errors-title">
        <h2 id="errors-title">Errors</h2>
        @if (s.Errors.Count == 0)
        {
            <div class="muted">@(s.TotalRequests == 0 ? "No responses yet." : "No errors so far.")</div>
        }
        else
        {
            <table>
                <tbody>
                    @foreach (var error in s.Errors)
                    {
                        <tr>
                            <td class="small">@error.Message</td>
                            <td class="num status-err">@error.Count.ToString("#,0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    private LoadTestRun? _run;
    private bool _planSaved;
    private string? _startError;
    private bool _stored;
    private bool _isBaseline;
    private RunHistoryEntry? _baseline;

    [Parameter] public Guid Id { get; set; }

    protected override void OnParametersSet()
    {
        if (_run is not null)
        {
            _run.Updated -= OnUpdated;
        }

        _run = RunManager.Get(Id);
        _planSaved = _run is not null && PlanStore.Get(_run.Plan.Id) is not null;
        LoadHistory();
        if (_run is not null)
        {
            _run.Updated += OnUpdated;
        }
    }

    protected override void OnInitialized() => History.Changed += OnHistoryChanged;

    private void LoadHistory()
    {
        _stored = _run is not null && History.GetEntry(_run.Id) is not null;
        _baseline = _run is null ? null : History.GetBaseline(_run.Plan.Id);
        _isBaseline = _run is not null && _baseline?.RunId == _run.Id;
    }

    private void OnUpdated(LoadTestRun run) => _ = InvokeAsync(StateHasChanged);

    // A run is stored when it finishes, and the baseline can change on another page or tab.
    private void OnHistoryChanged() => _ = InvokeAsync(() =>
    {
        LoadHistory();
        StateHasChanged();
    });

    private void SetBaseline()
    {
        if (_run is not null)
        {
            History.SetBaseline(_run.Plan.Id, _run.Id);
        }
    }

    private static double Progress(LoadTestSnapshot s, LoadProfile p)
    {
        if (s.IsFinished)
        {
            return 1;
        }

        var fraction = p.StopCondition == StopCondition.Duration
            ? s.Elapsed.TotalSeconds / p.DurationSeconds
            : (double)s.TotalRequests / p.TotalRequests;
        return Math.Clamp(fraction, 0, 1);
    }

    private static string StateMessage(LoadTestSnapshot s) => s.State switch
    {
        RunState.Pending => "The test is starting.",
        RunState.Running => "The test is running.",
        RunState.Completed => $"The test completed: {s.TotalRequests:#,0} requests, {Format.Percent(s.ErrorRate)} errors.{s.Passed switch { true => " It passed its thresholds.", false => " It failed its thresholds.", _ => "" }}",
        RunState.Cancelled => "The test was stopped.",
        _ => "The test failed.",
    };

    private static string ProgressLabel(LoadTestSnapshot s, LoadProfile p)
    {
        if (s.IsFinished)
        {
            return s.State switch
            {
                RunState.Completed => "Finished",
                RunState.Cancelled => "Stopped early",
                _ => "Failed",
            };
        }

        var percent = $"{Math.Round(Progress(s, p) * 100)}%";
        if (p.StopCondition == StopCondition.Duration)
        {
            return $"{percent} · {Format.Remaining(TimeSpan.FromSeconds(p.DurationSeconds) - s.Elapsed)}";
        }

        // With a request count the time left is only an estimate from the average rate so far.
        var left = p.TotalRequests - s.TotalRequests;
        return s.RequestsPerSecond > 0
            ? $"{percent} · about {Format.Remaining(TimeSpan.FromSeconds(left / s.RequestsPerSecond))}"
            : percent;
    }

    private static string Css(double fraction) =>
        (Math.Clamp(fraction, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static IReadOnlyList<ChartSeries> ThroughputSeries(LoadTestSnapshot s) =>
    [
        new("Requests/s", "var(--series-1)", s.Timeline.Select(t => (double)t.Requests).ToList(), Fill: true),
        new("Errors/s", "var(--series-3)", s.Timeline.Select(t => (double)t.Failures).ToList()),
    ];

    private static IReadOnlyList<ChartSeries> LatencySeries(LoadTestSnapshot s) =>
    [
        new("Mean", "var(--series-1)", s.Timeline.Select(t => t.MeanLatencyMs).ToList()),
        new("p95", "var(--series-2)", s.Timeline.Select(t => t.P95LatencyMs).ToList()),
    ];

    private void RunAgain()
    {
        if (_run is null)
        {
            return;
        }

        // Prefer the latest saved version of the test, if it still exists, and the environment this run used.
        _startError = null;
        var plan = PlanStore.Get(_run.Plan.Id) ?? _run.Plan;
        if (!EnvironmentStore.TryResolve(_run.EnvironmentName, out var environment, out var missing))
        {
            _startError = missing;
            return;
        }

        try
        {
            var next = RunManager.Start(plan, environment);
            Nav.NavigateTo($"runs/{next.Id}");
        }
        catch (ArgumentException ex)
        {
            _startError = ex.Message;
        }
    }

    public void Dispose()
    {
        History.Changed -= OnHistoryChanged;
        if (_run is not null)
        {
            _run.Updated -= OnUpdated;
        }
    }
}
