@page "/plans/new"
@page "/plans/{Id:guid}"
@inject PlanStore PlanStore
@inject RunManager RunManager
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_plan.Name) · falcon-load</PageTitle>

@if (_notFound)
{
    <div class="card empty">
        <h1 tabindex="-1">Test not found</h1>
        <p>That test doesn't exist any more. It may have been deleted in another tab.</p>
        <a class="btn" href="/">Back to dashboard</a>
    </div>
    return;
}

<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />

@{
    var planProblems = _showProblems ? _plan.Validate() : [];
    var profileProblems = _showProblems ? _plan.Profile.Validate().ToList() : [];
    var profile = _plan.Profile;
    var parameterSet = _showProblems ? new ParameterSet(_plan.Parameters) : null;
    var extracted = _plan.ExtractedVariables();
}

<div class="page-header editor-header">
    <div class="title">
        <h1 class="sr-only" tabindex="-1">@(Id is null ? "New test" : "Edit test")</h1>
        <label class="eyebrow" for="plan-name">@(Id is null ? "New test" : "Test name")</label>
        <div class="title-row">
            <input id="plan-name" class="name-input" type="text" @bind="_plan.Name" @bind:event="oninput" placeholder="Name this test" />
        </div>
    </div>
    <div class="actions">
        <span role="status">
            @if (IsDirty)
            {
                <span class="badge badge-unsaved">Unsaved changes</span>
            }
            else if (_savedMessage is not null)
            {
                <span class="badge badge-saved">@_savedMessage</span>
            }
        </span>
        @if (Id is { } savedId)
        {
            <a class="btn btn-ghost" href="api/plans/@savedId/export" download title="Download the saved version of this test, to import on another machine"><Icon Name="download" /><span class="hide-sm">Export</span></a>
        }
        <button @onclick="Save"><Icon Name="save" />Save</button>
        <button class="btn-primary" @onclick="SaveAndRun"><Icon Name="play" />Save &amp; run</button>
    </div>
</div>

@if (planProblems.Count > 0)
{
    <div class="alert alert-error" role="alert">
        <Icon Name="alert" />
        <div>
            <strong>@(planProblems.Count == 1 ? "One thing needs fixing" : $"{planProblems.Count} things need fixing") before this test can be saved or run.</strong>
            <ul>
                @foreach (var problem in planProblems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    </div>
}

<div class="editor-layout">
    <div class="stack">
        @for (var i = 0; i < _plan.Requests.Count; i++)
        {
            var index = i;
            var request = _plan.Requests[index];
            var tab = _tabs.GetValueOrDefault(request, "headers");
            var collapsed = _collapsed.Contains(request);
            var problems = _showProblems ? request.Validate(parameterSet, extracted).ToList() : [];
            var idp = $"req-{index}";
            <section class="card request-card @(problems.Count > 0 ? "has-error" : "")" aria-labelledby="@idp-title">
                <div class="card-header">
                    <div class="request-title">
                        <button class="collapse-toggle" aria-expanded="@(collapsed ? "false" : "true")" aria-controls="@idp-body"
                                aria-label="@(collapsed ? "Expand" : "Collapse") request @(index + 1)" @onclick="() => ToggleCollapsed(request)">
                            <Icon Name="chevron" />
                        </button>
                        <span class="step-num" aria-hidden="true">@(index + 1)</span>
                        <div class="request-summary">
                            <h3 id="@idp-title">@(string.IsNullOrWhiteSpace(request.Name) ? $"Request {index + 1}" : request.Name)</h3>
                            @if (request.OncePerVirtualUser)
                            {
                                <span class="badge badge-once" title="Sent once per virtual user">Once</span>
                            }
                            @if (collapsed)
                            {
                                <span class="@Format.MethodClass(request.Method)">@request.Method</span>
                                <span class="mono">@request.Url</span>
                            }
                        </div>
                    </div>
                    <div class="btn-group">
                        <button class="btn-sm btn-ghost btn-icon" title="Move up" aria-label="Move request @(index + 1) up" disabled="@(index == 0)" @onclick="() => Move(index, -1)"><Icon Name="up" /></button>
                        <button class="btn-sm btn-ghost btn-icon" title="Move down" aria-label="Move request @(index + 1) down" disabled="@(index == _plan.Requests.Count - 1)" @onclick="() => Move(index, 1)"><Icon Name="down" /></button>
                        <button class="btn-sm btn-ghost btn-icon btn-danger" title="@(_plan.Requests.Count == 1 ? "A test needs at least one request" : "Remove request")" aria-label="Remove request @(index + 1)"
                                disabled="@(_plan.Requests.Count == 1)" @onclick="() => RemoveRequest(index)"><Icon Name="trash" /></button>
                    </div>
                </div>

                @if (problems.Count > 0)
                {
                    <ul class="field-error">
                        @foreach (var problem in problems)
                        {
                            <li>@problem</li>
                        }
                    </ul>
                }

                <div id="@idp-body" hidden="@collapsed">
                    <div class="field">
                        <label for="@idp-name">Name <span class="optional">(optional)</span></label>
                        <input id="@idp-name" type="text" placeholder="e.g. List products" @bind="request.Name" @bind:event="oninput" />
                    </div>
                    <label class="check">
                        <input type="checkbox" @bind="request.OncePerVirtualUser" />
                        <span>Once per virtual user<span class="hint">Send it on the first iteration only, such as a login whose token later requests reuse. If it fails, it is sent again until it succeeds.</span></span>
                    </label>

                    <label for="@idp-url">Method and URL</label>
                    <div class="url-row">
                        <select @bind="request.Method" aria-label="HTTP method">
                            @foreach (var method in RequestDefinition.SupportedMethods)
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <input id="@idp-url" type="text" class="mono" placeholder="https://api.example.com/items" spellcheck="false" autocomplete="off"
                               aria-describedby="@idp-url-hint" @bind="request.Url" @bind:event="oninput" />
                        <button @onclick="() => Probe(request)" disabled="@_probing.Contains(request)" title="Send this request once and show the response">
                            <Icon Name="send" />@(_probing.Contains(request) ? "Sending…" : "Send once")
                        </button>
                    </div>
                    <div class="hint" id="@idp-url-hint">Dynamic values such as <code>{{$guid}}</code> work here too.</div>

                    <div class="tabs" role="tablist" aria-label="Request @(index + 1) details">
                        <button role="tab" id="@idp-tab-headers" aria-selected="@(tab == "headers" ? "true" : "false")" aria-controls="@idp-panel" @onclick='() => _tabs[request] = "headers"'>
                            Headers<span class="count">@request.Headers.Count(h => h.Enabled)</span>
                        </button>
                        <button role="tab" id="@idp-tab-body" aria-selected="@(tab == "body" ? "true" : "false")" aria-controls="@idp-panel" @onclick='() => _tabs[request] = "body"'>
                            Body
                            @if (!string.IsNullOrEmpty(request.Body))
                            {
                                <span class="dot" aria-label="has a body"></span>
                            }
                        </button>
                        <button role="tab" id="@idp-tab-checks" aria-selected="@(tab == "checks" ? "true" : "false")" aria-controls="@idp-panel" @onclick='() => _tabs[request] = "checks"'>
                            Checks<span class="count">@request.Assertions.Count(a => a.Enabled)</span>
                        </button>
                        <button role="tab" id="@idp-tab-extract" aria-selected="@(tab == "extract" ? "true" : "false")" aria-controls="@idp-panel" @onclick='() => _tabs[request] = "extract"'>
                            Extract<span class="count">@request.Extractions.Count</span>
                        </button>
                    </div>

                    <div role="tabpanel" id="@idp-panel" aria-labelledby="@idp-tab-@tab">
                        @if (tab == "headers")
                        {
                            @if (request.Headers.Count == 0)
                            {
                                <div class="hint">No headers yet. Common ones: <code>Authorization: Bearer …</code>, <code>Accept: application/json</code>, <code>X-Api-Key</code>.</div>
                            }
                            @for (var j = 0; j < request.Headers.Count; j++)
                            {
                                var h = request.Headers[j];
                                var n = j + 1;
                                <div class="header-row @(h.Enabled ? "" : "off")">
                                    <input type="checkbox" title="Send this header" aria-label="Send header @n" @bind="h.Enabled" />
                                    <input type="text" placeholder="Header" aria-label="Header @n name" spellcheck="false" @bind="h.Name" />
                                    <input type="text" class="mono h-value" placeholder="Value" aria-label="Header @n value" spellcheck="false" @bind="h.Value" />
                                    <button class="btn-sm btn-icon btn-ghost btn-danger h-remove" title="Remove header" aria-label="Remove header @n" @onclick="() => request.Headers.Remove(h)"><Icon Name="x" /></button>
                                </div>
                            }
                            <button class="btn-sm" @onclick="() => request.Headers.Add(new HeaderEntry())"><Icon Name="plus" />Add header</button>
                        }
                        else if (tab == "body")
                        {
                            <div class="field field-narrow">
                                <label for="@idp-ctype">Content type</label>
                                <input id="@idp-ctype" type="text" class="mono" list="content-types" @bind="request.ContentType" />
                            </div>
                            <label for="@idp-bodytext">Body</label>
                            <textarea id="@idp-bodytext" placeholder='{ "name": "falcon-{{$randomInt}}" }' spellcheck="false" @bind="request.Body" @bind:event="oninput"></textarea>
                            @if (request.Method is "GET" or "HEAD" && !string.IsNullOrEmpty(request.Body))
                            {
                                <div class="hint">Heads up: many servers ignore a body on @request.Method requests.</div>
                            }
                        }
                        else if (tab == "extract")
                        {
                            @if (request.Extractions.Count == 0)
                            {
                                <div class="hint">
                                    Take a value from this response, such as a login token, and use it in later requests as <code>{{token}}</code>.
                                    Each virtual user keeps its own values.
                                </div>
                            }
                            @for (var j = 0; j < request.Extractions.Count; j++)
                            {
                                var rule = request.Extractions[j];
                                var n = j + 1;
                                <div class="extract-row">
                                    <input type="text" class="mono" placeholder="token" aria-label="Extraction @n variable name" spellcheck="false" @bind="rule.Variable" @bind:event="oninput" />
                                    <select aria-label="Extraction @n source" @bind="rule.Source">
                                        <option value="@ExtractionSource.JsonPath">JSON path</option>
                                        <option value="@ExtractionSource.Header">Header</option>
                                        <option value="@ExtractionSource.Regex">Regex</option>
                                    </select>
                                    <input type="text" class="mono x-expr" placeholder="@ExpressionPlaceholder(rule.Source)" aria-label="Extraction @n @SourceLabel(rule.Source)" spellcheck="false"
                                           @bind="rule.Expression" @bind:event="oninput" />
                                    <button class="btn-sm btn-icon btn-ghost btn-danger x-remove" title="Remove extraction" aria-label="Remove extraction @n" @onclick="() => request.Extractions.Remove(rule)"><Icon Name="x" /></button>
                                </div>
                            }
                            <button class="btn-sm" @onclick='() => request.Extractions.Add(new ExtractionRule { Variable = request.Extractions.Count == 0 ? "token" : string.Empty })'><Icon Name="plus" />Add extraction</button>
                            <div class="hint">
                                A JSON path looks like <code>$.data.token</code> or <code>items[0].id</code>. A header is found by name, such as <code>Location</code>.
                                A regex takes its first capture group, or the whole match without one, e.g. <code>id="([^"]+)"</code>.
                                A response with an expected status that lacks the value counts as an error. "Send once" here makes the values available to "Send once" on later requests.
                            </div>
                        }
                        else
                        {
                            <div class="field field-narrow">
                                <label for="@idp-codes">Expected status codes</label>
                                <input id="@idp-codes" type="text" class="mono" placeholder="200-399 (default)" aria-describedby="@idp-codes-hint" @bind="request.ExpectedStatusCodes" />
                                <div class="hint" id="@idp-codes-hint">Comma separated codes or ranges, e.g. <code>200,201</code> or <code>200-299,404</code>. Any other status counts as an error.</div>
                            </div>

                            <div class="label-text" id="@idp-checks-label">Response checks</div>
                            @if (request.Assertions.Count == 0)
                            {
                                <div class="hint check-empty">
                                    No checks yet. A response that fails a check counts as an error, e.g. <code>$.status equals ok</code>,
                                    <code>body contains "id"</code> or <code>header Content-Type contains json</code>.
                                </div>
                            }
                            @for (var j = 0; j < request.Assertions.Count; j++)
                            {
                                var a = request.Assertions[j];
                                var n = j + 1;
                                <div class="check-row @(a.Enabled ? "" : "off")" role="group" aria-label="Check @n">
                                    <input type="checkbox" title="Run this check" aria-label="Run check @n" @bind="a.Enabled" />
                                    <select aria-label="Check @n looks at" @bind="a.Source" @bind:after="() => FixOperator(a)">
                                        <option value="@AssertionSource.Body">Body</option>
                                        <option value="@AssertionSource.JsonPath">JSON path</option>
                                        <option value="@AssertionSource.Header">Header</option>
                                    </select>
                                    @if (a.Source == AssertionSource.Body)
                                    {
                                        <span class="check-subject muted small">whole response body</span>
                                    }
                                    else
                                    {
                                        <input type="text" class="mono" spellcheck="false" aria-label="Check @n @(a.Source == AssertionSource.Header ? "header name" : "JSON path")"
                                               placeholder="@(a.Source == AssertionSource.Header ? "Content-Type" : "$.data.id")" @bind="a.Target" @bind:event="oninput" />
                                    }
                                    <select aria-label="Check @n comparison" @bind="a.Operator">
                                        @foreach (var op in Assertion.OperatorsFor(a.Source))
                                        {
                                            <option value="@op">@Assertion.OperatorText(op)</option>
                                        }
                                    </select>
                                    @if (Assertion.NeedsValue(a.Operator))
                                    {
                                        <input type="text" class="mono" spellcheck="false" aria-label="Check @n value" placeholder="@ValuePlaceholder(a.Operator)" @bind="a.Value" @bind:event="oninput" />
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <button class="btn-sm btn-icon btn-ghost btn-danger c-remove" title="Remove check" aria-label="Remove check @n" @onclick="() => request.Assertions.Remove(a)"><Icon Name="x" /></button>
                                </div>
                            }
                            <button class="btn-sm" disabled="@(request.Assertions.Count >= Assertion.MaxPerRequest)" @onclick="() => AddCheck(request)"><Icon Name="plus" />Add check</button>
                            <div class="hint">
                                JSON paths look like <code>$.items[0].id</code>, <code>$.items[-1]</code> (last) or <code>$.items.length</code>.
                                Text comparisons are case-sensitive, and "matches" takes a regular expression. Use "Send once" to see what each check finds.
                            </div>
                        }
                    </div>

                    @if (_probeResults.TryGetValue(request, out var probe))
                    {
                        <div class="probe" role="status">
                            <div class="probe-head">
                                @if (probe.StatusCode is { } statusCode)
                                {
                                    <strong class="@Format.StatusClass(statusCode.ToString())">@statusCode @probe.ReasonPhrase</strong>
                                    <span>@Format.Ms(probe.Latency.TotalMilliseconds)</span>
                                    <span>@Format.Bytes(probe.BodyBytes)</span>
                                    @if (!probe.StatusMatches)
                                    {
                                        <span class="status-err">Doesn't match the expected status codes</span>
                                    }
                                    else if (probe.Checks.Count(c => !c.Passed) is > 0 and var failedChecks)
                                    {
                                        <span class="status-err">@(failedChecks == 1 ? "1 check failed" : $"{failedChecks} checks failed")</span>
                                    }
                                }
                                else
                                {
                                    <strong class="status-err">Request failed</strong>
                                    <span>@probe.Error</span>
                                }
                                <span class="spacer"></span>
                                <button class="btn-sm btn-ghost btn-icon" aria-label="Close response" title="Close" @onclick="() => _probeResults.Remove(request)"><Icon Name="x" /></button>
                            </div>
                            @if (probe.Checks.Count > 0)
                            {
                                <span class="probe-label">Checks</span>
                                <ul class="probe-checks">
                                    @foreach (var check in probe.Checks)
                                    {
                                        <li class="@(check.Passed ? "status-2xx" : "status-err")">
                                            <Icon Name="@(check.Passed ? "check" : "x")" />
                                            <span class="sr-only">@(check.Passed ? "Passed:" : "Failed:")</span>
                                            <span class="mono">@check.Name</span>
                                            @if (check.Actual is not null)
                                            {
                                                <span class="muted mono">found @check.Actual</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @if (probe.StatusCode is not null)
                            {
                                <span class="probe-label">Response headers</span>
                                <pre>@string.Join("\n", probe.Headers.Select(h => $"{h.Key}: {h.Value}"))</pre>
                                @if (probe.Extractions is { Count: > 0 } extractions)
                                {
                                    <span class="probe-label">Extracted</span>
                                    <ul class="probe-extracts">
                                        @foreach (var item in extractions)
                                        {
                                            <li>
                                                <code>{{@item.Variable}}</code>
                                                @if (item.Value is not null)
                                                {
                                                    <span class="mono">@item.Value</span>
                                                }
                                                else
                                                {
                                                    <span class="status-err">@item.Error</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (!string.IsNullOrEmpty(probe.BodyPreview))
                                {
                                    <span class="probe-label">Body</span>
                                    <pre>@probe.BodyPreview</pre>
                                }
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <div>
            <button class="add-request" @onclick="AddRequest"><Icon Name="plus" />Add request</button>
            <div class="hint">Each virtual user sends the requests in this order, then starts over. Values it extracts from a response stay with it for its later requests.</div>
        </div>

        <section class="card" aria-labelledby="thresholds-title">
            <div class="card-header">
                <h2 id="thresholds-title">Pass/fail thresholds</h2>
                <button class="btn-sm" @onclick="AddThreshold"><Icon Name="plus" />Add threshold</button>
            </div>
            @if (_plan.Thresholds.Count == 0)
            {
                <div class="small muted">
                    Without thresholds a run has no verdict. Add rules such as <em>p95 latency &lt; 500 ms</em> or <em>error rate &lt; 1%</em>,
                    and every run says whether it passed, in the results and in the JSON API for CI.
                </div>
            }
            @for (var k = 0; k < _plan.Thresholds.Count; k++)
            {
                var t = _plan.Thresholds[k];
                var n = k + 1;
                <div class="threshold-row @(t.Enabled ? "" : "off")" role="group" aria-label="Threshold @n">
                    <input type="checkbox" title="Use this threshold" aria-label="Use threshold @n" @bind="t.Enabled" />
                    <select aria-label="Threshold @n metric" @bind="t.Metric">
                        @foreach (var metric in Enum.GetValues<ThresholdMetric>())
                        {
                            <option value="@metric">@Threshold.MetricText(metric)</option>
                        }
                    </select>
                    <select aria-label="Threshold @n applies to" @bind:get="@(t.RequestIndex?.ToString() ?? string.Empty)" @bind:set="value => t.RequestIndex = int.TryParse(value, out var i) ? i : null">
                        <option value="">All requests</option>
                        @for (var r = 0; r < _plan.Requests.Count; r++)
                        {
                            <option value="@r">Request @(r + 1)@(string.IsNullOrWhiteSpace(_plan.Requests[r].Name) ? "" : $": {_plan.Requests[r].Name}")</option>
                        }
                        @if (t.RequestIndex is { } missing && missing >= _plan.Requests.Count)
                        {
                            <option value="@missing">Request @(missing + 1) (removed)</option>
                        }
                    </select>
                    <select aria-label="Threshold @n comparison" class="mono" @bind="t.Operator">
                        @foreach (var op in Enum.GetValues<ThresholdOperator>())
                        {
                            <option value="@op">@Threshold.OperatorText(op)</option>
                        }
                    </select>
                    <div class="input-suffix">
                        <input type="number" min="0" step="any" aria-label="Threshold @n limit in @Threshold.Unit(t.Metric)" @bind="t.Value" @bind:event="oninput" />
                        <span>@Threshold.Unit(t.Metric)</span>
                    </div>
                    <button class="btn-sm btn-icon btn-ghost btn-danger t-remove" title="Remove threshold" aria-label="Remove threshold @n" @onclick="() => _plan.Thresholds.Remove(t)"><Icon Name="trash" /></button>
                </div>
            }
            @if (_plan.Thresholds.Count > 0)
            {
                <div class="hint">
                    A run passes when it completes and every threshold holds. Latency is per request, the error rate counts failed checks and
                    unexpected statuses, and throughput is the average over the run. A stopped run doesn't pass.
                </div>
            }
        </section>

        <section class="card" aria-labelledby="vars-title">
            <h2 id="vars-title">Dynamic values</h2>
            <div class="small muted">Use these anywhere in a URL, header value or body to make every request unique.</div>
            <table class="small vars-table">
                <tbody>
                    <tr><td><code>{{$guid}}</code></td><td class="muted">A new random GUID</td></tr>
                    <tr><td><code>{{$randomInt}}</code> or <code>{{$randomInt:1:100}}</code></td><td class="muted">Random integer (0–999999, or within a range)</td></tr>
                    <tr><td><code>{{$timestamp}}</code> / <code>{{$isoTimestamp}}</code></td><td class="muted">Current Unix time / ISO 8601 time</td></tr>
                    <tr><td><code>{{$vu}}</code> / <code>{{$iteration}}</code></td><td class="muted">Virtual user number / its iteration count</td></tr>
                    <tr><td><code>{{userIds}}</code></td><td class="muted">The next value of your parameter list with that name (below)</td></tr>
                    <tr><td><code>{{token}}</code></td><td class="muted">A value this virtual user extracted from an earlier response (a request's Extract tab)</td></tr>
                </tbody>
            </table>
        </section>

        <section class="card" aria-labelledby="params-title">
            <div class="card-header">
                <h2 id="params-title">Parameter lists</h2>
                <button class="btn-sm" @onclick="AddParameterList"><Icon Name="plus" />Add list</button>
            </div>
            @if (_plan.Parameters.Count == 0)
            {
                <div class="small muted">
                    Name a list of values, such as user ids, and write <code>{{name}}</code> in a URL, header value or body to use them.
                </div>
            }
            @for (var k = 0; k < _plan.Parameters.Count; k++)
            {
                var list = _plan.Parameters[k];
                var pid = $"param-{k}";
                <div class="parameter-list">
                    <div class="parameter-list-head">
                        <input id="@pid-name" type="text" class="mono" placeholder="userIds" aria-label="List @(k + 1) name" spellcheck="false" @bind="list.Name" @bind:event="oninput" />
                        <div class="segmented" role="group" aria-label="How list @(k + 1) picks values">
                            <button aria-pressed="@(list.Selection == ParameterSelection.Sequential ? "true" : "false")" title="Values in order, shared by all virtual users" @onclick="() => list.Selection = ParameterSelection.Sequential">In order</button>
                            <button aria-pressed="@(list.Selection == ParameterSelection.Random ? "true" : "false")" title="A random value each iteration" @onclick="() => list.Selection = ParameterSelection.Random">Random</button>
                        </div>
                        <button class="btn-sm btn-icon btn-ghost btn-danger" title="Remove list" aria-label="Remove list @(k + 1)" @onclick="() => _plan.Parameters.Remove(list)"><Icon Name="trash" /></button>
                    </div>
                    <textarea class="mono" rows="4" placeholder="One value per line" aria-label="List @(k + 1) values" aria-describedby="@pid-hint" spellcheck="false"
                              @bind:get="string.Join('\n', list.Values)" @bind:set="value => SetValues(list, value)"></textarea>
                    <div class="hint" id="@pid-hint">
                        Use as <code>{{@(string.IsNullOrWhiteSpace(list.Name) ? "name" : list.Name)}}</code>.
                        @list.Values.Count @(list.Values.Count == 1 ? "value" : "values"), one per line.
                    </div>
                </div>
            }
            <div class="hint">Each iteration takes one value from every list, so all its requests use the same one. "Send once" uses the first value.</div>
        </section>
    </div>

    <section class="card profile-card" aria-labelledby="profile-title">
        <h2 id="profile-title">Load profile</h2>
        <p class="hint">@ProfileSummary(profile)</p>

        @if (profileProblems.Count > 0)
        {
            <ul class="field-error">
                @foreach (var problem in profileProblems)
                {
                    <li>@problem</li>
                }
            </ul>
        }

        <div class="field">
            <label for="vus">Virtual users</label>
            <input id="vus" type="number" min="1" max="10000" aria-describedby="vus-hint" @bind="profile.Concurrency" @bind:event="oninput" />
            <div class="hint" id="vus-hint">How many requests are in flight at the same time.</div>
        </div>

        <div class="field">
            <div class="label-text" id="stop-label">Stop after</div>
            <div class="segmented" role="group" aria-labelledby="stop-label">
                <button aria-pressed="@(profile.StopCondition == StopCondition.Duration ? "true" : "false")" @onclick="() => profile.StopCondition = StopCondition.Duration">Duration</button>
                <button aria-pressed="@(profile.StopCondition == StopCondition.RequestCount ? "true" : "false")" @onclick="() => profile.StopCondition = StopCondition.RequestCount">Request count</button>
            </div>
        </div>

        @if (profile.StopCondition == StopCondition.Duration)
        {
            <div class="field">
                <label for="duration">Duration</label>
                <div class="input-suffix">
                    <input id="duration" type="number" min="1" @bind="profile.DurationSeconds" @bind:event="oninput" />
                    <span>sec</span>
                </div>
            </div>
        }
        else
        {
            <div class="field">
                <label for="total">Total requests</label>
                <input id="total" type="number" min="1" aria-describedby="total-hint" @bind="profile.TotalRequests" @bind:event="oninput" />
                <div class="hint" id="total-hint">Shared by all virtual users, so the test sends exactly this many.</div>
            </div>
        }

        <div class="field-row">
            <div class="field">
                <label for="rampup">Ramp-up</label>
                <div class="input-suffix">
                    <input id="rampup" type="number" min="0" @bind="profile.RampUpSeconds" @bind:event="oninput" />
                    <span>sec</span>
                </div>
            </div>
            <div class="field">
                <label for="timeout">Timeout</label>
                <div class="input-suffix">
                    <input id="timeout" type="number" min="1" max="600" @bind="profile.TimeoutSeconds" @bind:event="oninput" />
                    <span>sec</span>
                </div>
            </div>
        </div>

        <div class="field">
            <label for="rps">Rate cap</label>
            <div class="input-suffix">
                <input id="rps" type="number" min="0" step="any" aria-describedby="rps-hint" @bind="profile.MaxRequestsPerSecond" @bind:event="oninput" />
                <span>req/s</span>
            </div>
            <div class="hint" id="rps-hint">0 means unlimited: go as fast as the virtual users can.</div>
        </div>

        <div class="subsection-label">Connection</div>
        <label class="check"><input type="checkbox" @bind="profile.FollowRedirects" /><span>Follow redirects</span></label>
        <label class="check">
            <input type="checkbox" @bind="profile.IgnoreTlsErrors" />
            <span>Ignore TLS certificate errors<span class="hint">For local APIs with self-signed certificates.</span></span>
        </label>

        <div class="alert alert-info alert-compact">
            <Icon Name="info" /><div>Only load test APIs you own or have permission to test.</div>
        </div>
    </section>
</div>

<datalist id="content-types">
    <option value="application/json" />
    <option value="application/x-www-form-urlencoded" />
    <option value="application/xml" />
    <option value="text/plain" />
</datalist>

@code {
    private LoadTestPlan _plan = new();
    private bool _notFound;
    private bool _showProblems;
    private string? _savedMessage;
    private string _baseline = string.Empty;
    private readonly Dictionary<RequestDefinition, string> _tabs = new(ReferenceEqualityComparer.Instance);
    private readonly HashSet<RequestDefinition> _collapsed = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<RequestDefinition, ProbeResult> _probeResults = new(ReferenceEqualityComparer.Instance);
    private readonly HashSet<RequestDefinition> _probing = new(ReferenceEqualityComparer.Instance);

    // Values extracted by "Send once", so sending a login once lets the next request's "Send once" use its token.
    private readonly Dictionary<string, string> _probeVariables = new(StringComparer.OrdinalIgnoreCase);

    [Parameter] public Guid? Id { get; set; }

    // Comparing serialized JSON is cheap at plan sizes and catches every kind of edit, including reordering.
    private bool IsDirty => !_notFound && Snapshot(_plan) != _baseline;

    protected override void OnParametersSet()
    {
        if (Id is not null && Id == _plan.Id && !_notFound)
        {
            return; // Just saved a new plan and the URL caught up; keep the current state.
        }

        _showProblems = false;
        _savedMessage = null;
        _probeResults.Clear();
        _probeVariables.Clear();
        _collapsed.Clear();
        if (Id is { } id)
        {
            var plan = PlanStore.Get(id);
            _notFound = plan is null;
            _plan = plan ?? new LoadTestPlan();
        }
        else
        {
            _plan = new LoadTestPlan
            {
                Requests = [new RequestDefinition { Url = "https://localhost:5001/api/health", Headers = [new HeaderEntry { Name = "Accept", Value = "application/json" }] }],
            };
        }

        _baseline = Snapshot(_plan);
    }

    private static string Snapshot(LoadTestPlan plan) =>
        System.Text.Json.JsonSerializer.Serialize(new { plan.Name, plan.Requests, plan.Parameters, plan.Profile, plan.Thresholds });

    private static string ProfileSummary(LoadProfile p)
    {
        var users = p.Concurrency == 1 ? "1 virtual user" : $"{p.Concurrency:#,0} virtual users";
        var stop = p.StopCondition == StopCondition.Duration
            ? $"for {Format.Seconds(p.DurationSeconds)}"
            : $"until {p.TotalRequests:#,0} requests are sent";
        var ramp = p.RampUpSeconds > 0 ? $", starting over {Format.Seconds(p.RampUpSeconds)}" : string.Empty;
        var cap = p.MaxRequestsPerSecond > 0 ? $", at most {p.MaxRequestsPerSecond:#,0.##} req/s" : string.Empty;
        return $"{users} {stop}{ramp}{cap}.";
    }

    private static string ExpressionPlaceholder(ExtractionSource source) => source switch
    {
        ExtractionSource.Header => "Location",
        ExtractionSource.Regex => "token=([A-Za-z0-9._-]+)",
        _ => "$.data.token",
    };

    private static string SourceLabel(ExtractionSource source) => source switch
    {
        ExtractionSource.Header => "header name",
        ExtractionSource.Regex => "regular expression",
        _ => "JSON path",
    };

    private void ToggleCollapsed(RequestDefinition request)
    {
        if (!_collapsed.Remove(request))
        {
            _collapsed.Add(request);
        }
    }

    private void AddRequest() => _plan.Requests.Add(new RequestDefinition { Url = _plan.Requests.LastOrDefault()?.Url ?? "https://" });

    private void AddParameterList() => _plan.Parameters.Add(new ParameterList { Name = _plan.Parameters.Count == 0 ? "userIds" : string.Empty });

    // Blank lines are dropped, since a trailing newline in the text box shouldn't become an empty value.
    private static void SetValues(ParameterList list, string? text) =>
        list.Values = [.. (text ?? string.Empty).Split('\n').Select(v => v.TrimEnd('\r')).Where(v => v.Trim().Length > 0)];

    private void Move(int index, int delta)
    {
        var target = index + delta;
        (_plan.Requests[index], _plan.Requests[target]) = (_plan.Requests[target], _plan.Requests[index]);

        // Thresholds point at requests by position, so they follow the requests they were set on.
        foreach (var t in _plan.Thresholds)
        {
            t.RequestIndex = t.RequestIndex == index ? target : t.RequestIndex == target ? index : t.RequestIndex;
        }
    }

    private void RemoveRequest(int index)
    {
        _plan.Requests.RemoveAt(index);

        // A threshold on the removed request goes with it; those on later requests move up with theirs.
        _plan.Thresholds.RemoveAll(t => t.RequestIndex == index);
        foreach (var t in _plan.Thresholds.Where(t => t.RequestIndex > index))
        {
            t.RequestIndex--;
        }
    }

    private static void AddCheck(RequestDefinition request) =>
        request.Assertions.Add(request.Assertions.Count == 0
            ? new Assertion { Source = AssertionSource.JsonPath, Operator = AssertionOperator.Exists }
            : new Assertion());

    // Switching to the body drops operators that only make sense for a single value.
    private static void FixOperator(Assertion assertion)
    {
        if (!Assertion.OperatorsFor(assertion.Source).Contains(assertion.Operator))
        {
            assertion.Operator = AssertionOperator.Contains;
        }
    }

    private static string ValuePlaceholder(AssertionOperator op) => op switch
    {
        AssertionOperator.Matches => "^\\d+$",
        AssertionOperator.LessThan or AssertionOperator.GreaterThan => "100",
        _ => "text",
    };

    // The first threshold is the usual latency rule, the second an error budget, then a tail latency rule.
    private void AddThreshold() => _plan.Thresholds.Add(
        _plan.Thresholds.Count == 0 ? new Threshold { Metric = ThresholdMetric.P95Latency, Value = 500 }
        : _plan.Thresholds.All(t => t.Metric != ThresholdMetric.ErrorRate) ? new Threshold { Metric = ThresholdMetric.ErrorRate, Value = 1 }
        : new Threshold { Metric = ThresholdMetric.P99Latency, Value = 1000 });

    private bool TrySave(out LoadTestPlan saved)
    {
        saved = _plan;
        if (_plan.Validate().Count > 0)
        {
            // From now on problems update live as the user fixes them.
            _showProblems = true;
            return false;
        }

        saved = PlanStore.Save(_plan);
        _baseline = Snapshot(_plan);
        return true;
    }

    private void Save()
    {
        if (TrySave(out var saved))
        {
            _savedMessage = $"Saved at {DateTime.Now:HH:mm}";
            if (Id != saved.Id)
            {
                Nav.NavigateTo($"plans/{saved.Id}", replace: true);
            }
        }
    }

    private void SaveAndRun()
    {
        if (TrySave(out var saved))
        {
            var run = RunManager.Start(saved);
            Nav.NavigateTo($"runs/{run.Id}");
        }
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        // Our own redirect after saving a new test is not leaving the page.
        if (!IsDirty || context.TargetLocation.EndsWith($"plans/{_plan.Id}", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", "You have unsaved changes to this test. Leave without saving?"))
        {
            context.PreventNavigation();
        }
    }

    private async Task Probe(RequestDefinition request)
    {
        _probing.Add(request);
        _probeResults.Remove(request);
        try
        {
            _probeResults[request] = await RequestProbe.SendAsync(request, _plan.Profile, parameters: _plan.Parameters, variables: _probeVariables);
        }
        finally
        {
            _probing.Remove(request);
        }
    }
}
