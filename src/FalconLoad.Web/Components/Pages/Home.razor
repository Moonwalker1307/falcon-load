@page "/"
@implements IDisposable
@inject PlanStore PlanStore
@inject RunManager RunManager
@inject EnvironmentStore EnvironmentStore
@inject AgentRegistry Agents
@inject DistributedRunManager DistributedRuns
@inject NavigationManager Nav

<PageTitle>falcon-load</PageTitle>

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <div class="subtitle">Configure API requests, then hit them hard and watch how they hold up.</div>
    </div>
    <div class="actions">
        <label class="btn file-button" title="Load tests from a file exported by falcon-load">
            <Icon Name="upload" />Import…
            <InputFile accept=".json,application/json" OnChange="Import" />
        </label>
        <a class="btn" href="import" title="Create a test from a curl command, a Postman collection or an OpenAPI spec"><Icon Name="plus" />From curl, Postman or OpenAPI…</a>
        @if (_plans.Count > 0)
        {
            <a class="btn" href="api/plans/export" download title="Download every saved test as one file"><Icon Name="download" />Export all</a>
        }
        <a class="btn btn-primary" href="plans/new"><Icon Name="plus" />New load test</a>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-error" role="alert"><Icon Name="alert" /><div>@_error</div></div>
}

@if (_importProblems.Count > 0)
{
    <div class="alert alert-error" role="alert">
        <Icon Name="alert" />
        <div>
            <strong>Couldn't import @_importFileName.</strong> Nothing was saved.
            <ul>
                @foreach (var problem in _importProblems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
        <span class="spacer"></span>
        <button class="btn-ghost btn-icon btn-sm" aria-label="Dismiss" @onclick="() => _importProblems = []"><Icon Name="x" /></button>
    </div>
}

@if (_importMessage is not null)
{
    <div class="alert alert-info" role="status">
        <Icon Name="check" /><div>@_importMessage</div>
        <span class="spacer"></span>
        <button class="btn-ghost btn-icon btn-sm" aria-label="Dismiss" @onclick="() => _importMessage = null"><Icon Name="x" /></button>
    </div>
}

@if (_plans.Count == 0)
{
    <section class="card empty" aria-labelledby="welcome-title">
        <img class="empty-icon" src="falcon.svg" alt="" />
        <h2 id="welcome-title">Set up your first load test</h2>
        <p>A test is a list of HTTP requests plus how hard to send them. It takes about a minute.</p>
        <ol class="steps">
            <li><strong>Describe the requests</strong><span>Method, URL, headers and body. Use "Send once" to check each one works.</span></li>
            <li><strong>Choose the load</strong><span>How many virtual users, for how long, and an optional rate cap.</span></li>
            <li><strong>Watch it live</strong><span>Throughput, latency percentiles, status codes and errors, every second.</span></li>
        </ol>
        <div class="actions actions-center">
            <a class="btn btn-primary" href="plans/new"><Icon Name="plus" />Create a test</a>
        </div>
        <p class="hint">Already have the requests? <a href="import">Import them from curl, Postman or OpenAPI</a>. Got a file from another machine? Use <strong>Import…</strong> above.</p>
    </section>
}
else
{
    <section class="card card-flush" aria-labelledby="saved-title">
        <div class="card-header">
            <h2 id="saved-title">Saved tests</h2>
            <span class="muted small">@_plans.Count @(_plans.Count == 1 ? "test" : "tests")</span>
        </div>
        <div class="table-wrap">
            <table class="table-hover stack-sm">
                <thead>
                    <tr>
                        <th scope="col">Test</th>
                        <th scope="col">Load</th>
                        <th scope="col" class="hide-sm">Updated</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in _plans)
                    {
                        <tr>
                            <td>
                                <a class="row-title" href="plans/@plan.Id">@plan.Name</a>
                                @foreach (var r in plan.Requests.Take(2))
                                {
                                    <div class="request-line"><span class="@Format.MethodClass(r.Method)">@r.Method</span><span class="mono muted" title="@r.Url">@r.Url</span></div>
                                }
                                @if (plan.Requests.Count > 2)
                                {
                                    <div class="small muted">+ @(plan.Requests.Count - 2) more</div>
                                }
                            </td>
                            <td class="load-cell">
                                <div>@plan.Profile.Concurrency @(plan.Profile.Concurrency == 1 ? "user" : "users")</div>
                                <div class="small muted">@Format.StopSummary(plan.Profile)</div>
                                @if (_environmentNames.Count > 0 || !string.IsNullOrWhiteSpace(plan.Environment))
                                {
                                    <select class="env-select" aria-label="Environment to run @plan.Name with" title="Environment for this run"
                                            @bind:get="EnvironmentFor(plan)" @bind:set="value => _chosen[plan.Id] = value ?? string.Empty">
                                        <option value="">No environment</option>
                                        @foreach (var name in _environmentNames)
                                        {
                                            <option value="@name">@name</option>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(plan.Environment) && !_environmentNames.Contains(plan.Environment, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <option value="@plan.Environment">@plan.Environment (not found)</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td class="hide-sm muted nowrap">@Format.When(plan.UpdatedAt)</td>
                            <td class="actions">
                                @if (_confirmDelete == plan.Id)
                                {
                                    <div class="btn-group" role="group" aria-label="Confirm delete">
                                        <span class="small muted">Delete this test?</span>
                                        <button class="btn-sm btn-danger-solid" @onclick="() => Delete(plan)">Delete</button>
                                        <button class="btn-sm" @onclick="() => _confirmDelete = null">Keep</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="btn-group">
                                        <button class="btn-sm btn-primary" @onclick="() => Run(plan)" aria-label="Run @plan.Name"><Icon Name="play" />Run</button>
                                        @if (_agentCount > 0)
                                        {
                                            <button class="btn-sm" @onclick="() => RunOnAgents(plan)" title="Run on the @_agentCount enabled @(_agentCount == 1 ? "agent" : "agents")" aria-label="Run @plan.Name on agents"><Icon Name="agents" />Agents</button>
                                        }
                                        <a class="btn btn-sm" href="plans/@plan.Id" aria-label="Edit @plan.Name"><Icon Name="edit" />Edit</a>
                                        <button class="btn-sm btn-ghost btn-icon" @onclick="() => Duplicate(plan)" title="Duplicate" aria-label="Duplicate @plan.Name"><Icon Name="copy" /></button>
                                        <a class="btn btn-sm btn-ghost btn-icon" href="api/plans/@plan.Id/export" download title="Export to a file" aria-label="Export @plan.Name"><Icon Name="download" /></a>
                                        <button class="btn-sm btn-ghost btn-icon btn-danger" @onclick="() => _confirmDelete = plan.Id" title="Delete" aria-label="Delete @plan.Name"><Icon Name="trash" /></button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="card card-flush" aria-labelledby="recent-title">
    <div class="card-header">
        <h2 id="recent-title">Recent runs</h2>
        <a href="runs" class="small">All runs →</a>
    </div>
    <RunsTable Limit="10" />
</section>

@code {
    private IReadOnlyList<LoadTestPlan> _plans = [];
    private IReadOnlyList<string> _environmentNames = [];

    // The environment picked for the next run of a test, when it differs from the test's own setting.
    private readonly Dictionary<Guid, string> _chosen = [];
    private string? _error;
    private Guid? _confirmDelete;
    private IReadOnlyList<string> _importProblems = [];
    private string? _importFileName;
    private string? _importMessage;

    // Exported files are a few kilobytes; the cap only stops someone picking a huge file by mistake.
    private const long MaxImportBytes = 5 * 1024 * 1024;

    private int _agentCount;

    protected override void OnInitialized()
    {
        _plans = PlanStore.GetAll();
        _environmentNames = [.. EnvironmentStore.GetAll().Select(e => e.Name)];
        PlanStore.Changed += OnPlansChanged;
        EnvironmentStore.Changed += OnPlansChanged;
        _agentCount = Agents.GetEnabled().Count;
        Agents.Changed += OnAgentsChanged;
    }

    private void OnAgentsChanged() => _ = InvokeAsync(() =>
    {
        _agentCount = Agents.GetEnabled().Count;
        StateHasChanged();
    });

    private void RunOnAgents(LoadTestPlan plan)
    {
        _error = null;
        if (!EnvironmentStore.TryResolve(EnvironmentFor(plan), out var environment, out var missing))
        {
            _error = $"{plan.Name}: {missing}";
            return;
        }

        try
        {
            var run = DistributedRuns.Start(plan, environment);
            Nav.NavigateTo($"distributed/{run.Id}");
        }
        catch (ArgumentException ex)
        {
            _error = $"{plan.Name}: {ex.Message}";
        }
    }

    private void OnPlansChanged() => _ = InvokeAsync(() =>
    {
        _plans = PlanStore.GetAll();
        _environmentNames = [.. EnvironmentStore.GetAll().Select(e => e.Name)];
        StateHasChanged();
    });

    private string EnvironmentFor(LoadTestPlan plan) => _chosen.TryGetValue(plan.Id, out var name) ? name : plan.Environment ?? string.Empty;

    private void Run(LoadTestPlan plan)
    {
        _error = null;
        if (!EnvironmentStore.TryResolve(EnvironmentFor(plan), out var environment, out var missing))
        {
            _error = $"{plan.Name}: {missing}";
            return;
        }

        try
        {
            var run = RunManager.Start(plan, environment);
            Nav.NavigateTo($"runs/{run.Id}");
        }
        catch (ArgumentException ex)
        {
            _error = $"{plan.Name}: {ex.Message}";
        }
    }

    private void Duplicate(LoadTestPlan plan)
    {
        var copy = plan.Clone();
        copy.Id = Guid.NewGuid();
        copy.Name = $"{plan.Name} (copy)";
        PlanStore.Save(copy);
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        _importProblems = [];
        _importMessage = null;
        _importFileName = e.File.Name;
        if (e.File.Size > MaxImportBytes)
        {
            _importProblems = [$"The file is larger than {MaxImportBytes / (1024 * 1024)} MB."];
            return;
        }

        string json;
        await using (var stream = e.File.OpenReadStream(MaxImportBytes))
        using (var reader = new StreamReader(stream))
        {
            json = await reader.ReadToEndAsync();
        }

        var import = PlanFile.Read(json);
        if (!import.Succeeded)
        {
            _importProblems = import.Problems;
            return;
        }

        var saved = PlanStore.SaveAll(import.Plans);
        _importMessage = saved.Count == 1
            ? $"Imported \"{saved[0].Name}\" from {e.File.Name}."
            : $"Imported {saved.Count} tests from {e.File.Name}.";
    }

    private void Delete(LoadTestPlan plan)
    {
        _confirmDelete = null;
        PlanStore.Delete(plan.Id);
    }

    public void Dispose()
    {
        PlanStore.Changed -= OnPlansChanged;
        EnvironmentStore.Changed -= OnPlansChanged;
        Agents.Changed -= OnAgentsChanged;
    }
}
