<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FalconLoad.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <HeadOutlet @rendermode="RenderModeServer" />
</head>

<body>
    <Routes @rendermode="RenderModeServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode RenderModeServer = new InteractiveServerRenderMode(prerender: false);
}
